{
  "name": "qe-ui-e2e-playwright",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "scripts": {
    "test": "bddgen && playwright test",
    "ui": "bddgen && playwright test --ui",
    "chromium": "bddgen && playwright test --project=chromium",
    "firefox": "bddgen && playwright test --project=firefox",
    "webkit": "bddgen && playwright test --project=webkit",
    "headed": "bddgen && playwright test --headed",
    "smoke": "bddgen && playwright test --grep @smoke",
    "regression": "bddgen && playwright test --grep @regression",
    "journey": "bddgen && playwright test --grep @journey",
    "validation": "bddgen && playwright test --grep @validation",
    "calculation": "bddgen && playwright test --grep @calculation",
    "accessibility": "bddgen && playwright test --grep @accessibility",
    "holiday-entitlement": "bddgen && playwright test --grep @holiday-entitlement",
    "test:report": "playwright show-report",
    "install:browsers": "playwright install",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "axe-core": "^4.14.1",
    "axe-html-reporter": "^2.2.11",
    "eslint": "^10.15.0",
    "eslint-plugin-playwright": "^2.12.2",
    "playwright-bdd": "^9.2.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0"
  }
}
